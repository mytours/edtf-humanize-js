{
  "name": "edtf-humanize",
  "version": "0.1.0",
  "description": "Turn Extended Date/Time Format (EDTF / ISO 8601-2) strings into human-readable text, in English, French, German and Italian",
  "keywords": [
    "edtf",
    "iso8601",
    "iso 8601-2",
    "date",
    "humanize",
    "i18n"
  ],
  "license": "BSD-3-Clause",
  "author": "Glen Barnes",
  "contributors": [
    "Cory Lown (author of the Ruby edtf-humanize gem)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mytours/edtf-humanize-js.git"
  },
  "bugs": "https://github.com/mytours/edtf-humanize-js/issues",
  "homepage": "https://github.com/mytours/edtf-humanize-js#readme",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check:package": "publint --pack npm && attw --pack .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:dist",
    "test:dist": "node scripts/smoke.cjs && node scripts/smoke.mjs"
  },
  "dependencies": {
    "edtf": "4.11.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
